{
  "name": "plynt",
  "productName": "Plynt",
  "version": "0.1.0-preview.6",
  "userDataDirectory": "AI Workspace Preview",
  "private": true,
  "description": "Plynt: a desktop workspace for AI services with private local diagnostics",
  "author": "Plynt contributors",
  "homepage": "https://github.com/leemh-dev/plynt",
  "repository": {
    "type": "git",
    "url": "https://github.com/leemh-dev/plynt.git"
  },
  "bugs": {
    "url": "https://github.com/leemh-dev/plynt/issues"
  },
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "start": "electron .",
    "fixtures": "electron . --fixtures",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.aiworkspace.preview",
    "asar": true,
    "publish": [],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Plynt contributors",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png"
  }
}
